# Normalize line endings so CI (Linux) and Windows agree. gradlew MUST stay LF.
* text=auto eol=lf

# Windows-only scripts keep CRLF.
*.bat text eol=crlf

# Gradle wrapper script is executed by /bin/sh on CI — force LF.
gradlew text eol=lf

# Binary assets: never normalize.
*.jar binary
*.png binary
*.jpg binary
*.webp binary
*.apk binary
*.aab binary
*.keystore binary
*.jks binary
