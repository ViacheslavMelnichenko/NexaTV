# === NexaTV .gitignore ===
# Phase 0 is docs-only. Flutter/Android/Gradle entries are included ahead of time so that
# when the code foundation lands, build artifacts are never accidentally committed.

# --- Secrets / runtime device info (NEVER commit) ---
# Pairing codes, device IPs/ports, tokens, and local-only notes.
*.secret
*.secrets
secrets/
.env
.env.*
*.local
device-pairing*.txt
**/local.properties

# --- OS / editor ---
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.iml
*.swp

# --- Flutter / Dart ---
.dart_tool/
.packages
.pub-cache/
.pub/
build/
.flutter-plugins
.flutter-plugins-dependencies
coverage/

# --- Android / Gradle ---
*.apk
*.aab
*.ap_
*.dex
.gradle/
captures/
**/*.keystore
**/*.jks
key.properties

# --- Logs / scratch ---
*.log
logcat-*.txt
scratch/
tmp/

# --- Throwaway validation spike (ADR-0002 gate) & downloaded tools ---
# Spike is a disposable build to validate the stack on the real TCL; never part of history.
spike/
tools/
