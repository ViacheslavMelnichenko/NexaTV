<?xml version="1.0" encoding="utf-8"?>
<!-- NexaTV — app manifest. Apache-2.0. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- TV device: leanback required, no touchscreen. -->
    <uses-feature
        android:name="android.software.leanback"
        android:required="true" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <!--
      NFR-021: no INTERNET / ACCESS_NETWORK_STATE permissions.
      App enumeration uses LauncherApps via ROLE_HOME (ADR-0004) — no QUERY_ALL_PACKAGES.
      FR-009: RECEIVE_BOOT_COMPLETED is intentionally NOT declared.
    -->

    <!--
      Package visibility (Android 11+). On this Google TV firmware NexaTV never becomes the real
      system HOME (the override is an accessibility shim, ADR-0006/0007), so it is NOT auto-granted
      visibility of every installed app — without this it sees only a handful of packages and the
      grid looks almost empty. We declare exactly the launcher intents we resolve (standard + TV
      "leanback" launchers), which grants visibility of just those apps — still no QUERY_ALL_PACKAGES
      (ADR-0004).
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:banner="@drawable/banner"
        android:label="@string/app_name"
        android:supportsRtl="false"
        android:theme="@style/Theme.NexaTV">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="landscape"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode|density|fontScale">

            <!-- FR-001: register as the TV HOME / leanback launcher. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Prototype HOME override (ADR-0006 follow-up): Google TV pins its own launcher to the HOME
          button, so NexaTV raises itself when the stock launcher appears. Reversible — the user must
          enable this in Settings → Accessibility; the stock launcher is never disabled.
        -->
        <service
            android:name=".override.NexaOverrideService"
            android:exported="true"
            android:label="@string/accessibility_override_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/nexa_accessibility_config" />
        </service>

        <!-- Allows profiling (Macrobenchmark / Perfetto) without affecting release behavior. -->
        <profileable
            android:shell="true"
            tools:targetApi="29" />
    </application>
</manifest>
