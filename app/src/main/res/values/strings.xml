    <!-- HOME-override accessibility service (prototype; ADR-0006 follow-up) -->
    <string name="accessibility_override_label">NexaTV Home override</string>
    <string name="accessibility_override_description">Lets NexaTV open as your Home when you press the HOME button. NexaTV only detects when the system launcher appears; it never reads screen content. Turn this off any time to return to the stock Home.</string>
