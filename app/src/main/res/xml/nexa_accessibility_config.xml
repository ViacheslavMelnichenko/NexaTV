<?xml version="1.0" encoding="utf-8"?>
<!--
  Prototype HOME-override accessibility service (ADR-0006 follow-up). Watches only window-state
  changes to detect the stock launcher; does not retrieve window content (no content is read).
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/accessibility_override_description"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:canRetrieveWindowContent="false"
    android:notificationTimeout="0" />
